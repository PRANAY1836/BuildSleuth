APP_ENV=development
APP_NAME=BuildSleuth
APP_VERSION=0.2.0
LOG_LEVEL=INFO

ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000
MAX_UPLOAD_BYTES=5242880
RATE_LIMIT_REQUESTS_PER_MINUTE=60

DATA_DIR=./data
SQLITE_DB_PATH=./data/buildsleuth.db

ENABLE_DENSE_RETRIEVAL=true
ENABLE_RERANKER=true
ENABLE_GRAPH_RAG=true
RRF_K=60
MAX_AGENT_RETRIES=2

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GITHUB_TOKEN=
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=